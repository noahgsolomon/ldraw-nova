#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
# Local launcher for the complete, separately maintained Nova toolkit.
set -eu

nova_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
nova_python=${NOVA_PYTHON:-"$nova_root/.venv/bin/python"}
nova_library=${NOVA_LDRAW_DIR:-}
nova_render_bin=${NOVA_RENDER_BIN:-}

usage() {
  cat <<'EOF'
Usage: second-brick/run cli ARGS...
       second-brick/run python GENERATOR.py [ARGS...]
       second-brick/run test [PYTEST_ARGS...]

Configuration (paths, not credentials):
  NOVA_PYTHON       Absolute Python executable; defaults to .venv/bin/python.
  NOVA_LDRAW_DIR    Absolute official LDraw library directory (required).
  NOVA_RENDER_BIN   Optional absolute directory containing a LeoCAD launcher.

Commands run from the fork root with a fresh environment. Use absolute paths
for project inputs/outputs outside the fork. This removes inherited credentials;
it is not an OS sandbox and does not authorize untrusted generators or paid APIs.
EOF
}

case ${1:-} in
  -h|--help|'') usage; exit 0 ;;
  cli) shift; set -- -m ldraw_tools.cli "$@" ;;
  python) shift; if [ "$#" -eq 0 ]; then usage >&2; exit 2; fi ;;
  test) shift; set -- -m pytest "$@" ;;
  *) usage >&2; exit 2 ;;
esac

case "$nova_python" in /*) ;; *) echo 'NOVA_PYTHON must be an absolute path.' >&2; exit 2 ;; esac
case "$nova_library" in /*) ;; *) echo 'NOVA_LDRAW_DIR must be an absolute path.' >&2; exit 2 ;; esac
case "$nova_render_bin" in ''|/*) ;; *) echo 'NOVA_RENDER_BIN must be an absolute directory.' >&2; exit 2 ;; esac
if [ ! -x "$nova_python" ] || [ ! -d "$nova_library/parts" ] || [ ! -f "$nova_library/LDConfig.ldr" ]; then
  echo 'Install the locked Python environment and official LDraw library first.' >&2
  exit 2
fi
if [ -n "$nova_render_bin" ] && [ ! -d "$nova_render_bin" ]; then
  echo 'NOVA_RENDER_BIN directory does not exist.' >&2
  exit 2
fi

umask 077
nova_state="$nova_root/output/local-runtime"
mkdir -p "$nova_state/home" "$nova_state/xdg" "$nova_state/cache"
nova_path="$(dirname -- "$nova_python"):/usr/bin:/bin"
if [ -n "$nova_render_bin" ]; then nova_path="$nova_render_bin:$nova_path"; fi
cd "$nova_root"
exec env -i \
  PATH="$nova_path" \
  HOME="$nova_state/home" \
  LANG=C.UTF-8 \
  PYTHONPATH="$nova_root" \
  PYTHONNOUSERSITE=1 \
  LDRAW_DIR="$nova_library" \
  QT_QPA_PLATFORM=offscreen \
  LIBGL_ALWAYS_SOFTWARE=1 \
  XDG_RUNTIME_DIR="$nova_state/xdg" \
  XDG_CACHE_HOME="$nova_state/cache" \
  "$nova_python" "$@"
